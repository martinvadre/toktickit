# ==============================================================================
# TokTickIT Server Environment Variables Template (server/.env.example)
# Copy to server/.env for local development. NEVER commit server/.env to Git!
# ==============================================================================

# Server port (Cloud Run injects PORT automatically; defaults to 3000)
PORT=3000

# Runtime environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string
# Local: postgresql://postgres:postgres@localhost:5432/toktickit?schema=public
# Cloud SQL Unix Socket: postgresql://toktickit_app:<PASSWORD>@localhost/toktickit?host=/cloudsql/<PROJECT_ID>:<REGION>:toktickit-pg
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toktickit?schema=public"

# Allowed CORS origin(s), comma-separated (optional for same-origin Cloud Run deployment)
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign and verify JWT authentication tokens
JWT_SECRET="replace-with-secure-random-hex-secret"

# Initial password for admin@kmutt.ac.th during database seeding
ADMIN_PASSWORD="replace-with-strong-admin-password"

# Default password for sample requester/staff accounts when SEED_DEMO_DATA="true"
DEMO_USER_PASSWORD="Password123!"

# Set to "true" to seed sample requester/staff accounts and demo tickets; "false" in production
SEED_DEMO_DATA="true"
