# ==============================================================================
# TokTickIT — Root Environment Variables Template (.env.example)
# Copy to .env for local development. NEVER commit real secrets to Git!
# ==============================================================================

# --- Backend Runtime & Database ---
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toktickit?schema=public"
CORS_ORIGIN="http://localhost:5173"

# --- Authentication & Seeding ---
JWT_SECRET="replace-with-secure-random-hex-secret"
ADMIN_PASSWORD="replace-with-strong-admin-password"
DEMO_USER_PASSWORD="Password123!"
SEED_DEMO_DATA="true"
ALLOW_LEGACY_REQUESTER_HEADER="false"

# --- Frontend Build ---
# Leave empty ("") for same-origin production builds; use http://localhost:3000 for local Vite dev
VITE_API_URL="http://localhost:3000"

# --- Docker Compose Local PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=toktickit
